<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_product_purchase_history_line_list" model="ir.ui.view">
            <field name="name">product.purchase.history.line.list</field>
            <field name="model">product.purchase.history.line</field>
            <field name="arch" type="xml">
                <list string="Price History Table" create="false" edit="false" delete="false">
                    <field name="purchase_order_id"/>
                    <field name="history_price"/>
                    <field name="history_qty"/>
                    <field name="history_total"/>
                </list>
            </field>
        </record>

        <record id="product_purchase_order_history_view_form" model="ir.ui.view">
            <field name="name">Product Purchase history</field>
            <field name="model">product.purchase.order.history</field>
            <field name="arch" type="xml">
                <form string="Product Purchase History">
                    <div>
                        <field name="product_id" readonly="1"/>
                        <field name="product_purchase_history_ids" mode="list" nolabel="1" readonly="1">
                            <list string="Price History Table">
                                <field name="order_line_id" column_invisible="1"/>
                                <field name="purchase_order_id"/>
                                <field name="history_price"/>
                                <field name="history_qty"/>
                                <field name="history_total"/>
                            </list>
                        </field>
                    </div>
                    <separator string="Price History Table for generic customer"/>
                    <div>
                        <field name="product_purchase_ohistory_ids" mode="list" nolabel="1" readonly="1">
                            <list string="Price History Table for generic customer">
                                <field name="order_line_id" column_invisible="1"/>
                                <field name="partner_id"/>
                                <field name="purchase_order_id"/>
                                <field name="history_price"/>
                                <field name="history_qty"/>
                                <field name="history_total"/>
                            </list>
                        </field>
                    </div>
                    
                    <footer>
                        <button string="Cancel" class="btn btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="product_purchase_order_history_action" model="ir.actions.act_window">
            <field name="name">Product Purchase history</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.purchase.order.history</field>
            <field name="view_id" ref="product_purchase_order_history_view_form"/>
            <field name="view_mode">list</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>